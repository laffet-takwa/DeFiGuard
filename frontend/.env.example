# DeFiGuard frontend environment configuration
# Copy this file to `.env` and fill in the addresses printed by the deploy script:
#   forge script script/Deploy.s.sol --rpc-url <rpc> --broadcast
# (or deploy with anvil + `forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --broadcast`)

# Address of the deployed LendingPool contract
VITE_LENDING_POOL_ADDRESS=

# Address of the collateral token (WETH mock, 18 decimals)
VITE_COLLATERAL_TOKEN_ADDRESS=

# Address of the borrow token (USDC mock, 6 decimals)
VITE_BORROW_TOKEN_ADDRESS=

# Expected chain id (31337 = anvil/hardhat local node)
VITE_CHAIN_ID=31337
